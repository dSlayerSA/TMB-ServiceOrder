# PostgreSQL
POSTGRES_DB=orders
POSTGRES_USER=orders_user
POSTGRES_PASSWORD=change_me

# pgAdmin
PGADMIN_EMAIL=admin@example.com
PGADMIN_PASSWORD=change_me

# RabbitMQ
RABBITMQ_USER=orders_user
RABBITMQ_PASSWORD=change_me

# Frontend -> Browser-facing API URL (used by the browser/client code)
PUBLIC_API_URL=http://localhost:8080

# IA/Analytics module (optional). Two ways to run it:
#
#  1. Claude (melhor qualidade, pago por pergunta): preencha a chave abaixo.
#  2. Ollama (local, de graça): deixe a chave vazia, use ANALYTICS_PROVIDER=Ollama
#     e suba com `docker compose --profile local-ai up -d`.
#
# Sem nenhum dos dois o módulo fica desativado e o resto da stack roda normalmente.
ANTHROPIC_API_KEY=
ANALYTICS_PROVIDER=Claude
OLLAMA_MODEL=qwen2.5:3b
