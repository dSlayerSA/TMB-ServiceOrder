# Only needed to run the frontend outside Docker (npm run dev).
# Under Docker Compose both are set from PUBLIC_API_URL in the root .env.

# Server-side calls, made by the Next.js server while rendering.
# Inside Docker this becomes http://api:8080 (the service name).
API_INTERNAL_URL=http://localhost:8080

# Browser-side calls. Inlined into the client bundle at build time, so it has
# to be an address the browser itself can reach.
NEXT_PUBLIC_API_URL=http://localhost:8080
